{
	"name": "true-recall",
	"version": "2.9.1",
	"private": true,
	"description": "Spaced repetition with FSRS algorithm",
	"main": "main.js",
	"type": "module",
	"workspaces": [
		"packages/*",
		"packages/plugins",
		"mcp-server"
	],
	"overrides": {
		"picomatch": "4.0.4",
		"@hono/node-server": "1.19.15",
		"hono": "4.13.5",
		"fast-uri": "3.1.7",
		"ip-address": "10.7.0",
		"typescript-eslint": "8.61.1"
	},
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
		"version": "bun version-bump.mjs && git add manifest.json versions.json",
		"format": "biome format --write packages/",
		"biome": "biome check --write packages/",
		"test": "bun vitest run",
		"test:e2e:local-api": "bun vitest run packages/obsidian/tests/e2e/local-api-client.e2e.test.ts",
		"test:watch": "bun vitest",
		"test:coverage": "bun vitest run --coverage",
		"test:e2e:mobile": "bun e2e/mobile/run.ts",
		"render:excalidraw": "bunx --bun excalirender",
		"changelog": "bun scripts/generate-changelog.ts",
		"changelog:preview": "bun scripts/generate-changelog.ts --preview",
		"release:beta": "bun scripts/release-beta.ts",
		"perf:benchmark": "bun scripts/perf-benchmark.ts",
		"cli:build": "cd cli && bun build --compile --minify index.ts --outfile true-recall",
		"agent-tools:check": "cd mcp-server && tsc --noEmit -p tsconfig.json",
		"knip": "bunx knip",
		"lint:obsidian": "eslint ."
	},
	"keywords": [],
	"license": "PolyForm-Strict-1.0.0",
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@tailwindcss/cli": "^4.3.3",
		"@types/bun": "1.4.2",
		"@types/node": "^20.19.43",
		"@types/pako": "^2.0.4",
		"@typescript-eslint/parser": "8.71.1",
		"@vitest/coverage-v8": "^4.1.11",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"excalirender": "github:JonRC/excalirender",
		"knip": "^6.40.0",
		"postcss": "^8.5.29",
		"sql.js": "^1.14.2",
		"tailwindcss": "^4.3.3",
		"tslib": "2.8.1",
		"typescript": "5.8.3",
		"vite": "^8.3.3",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "^6.43.14",
		"@floating-ui/dom": "^1.8.0",
		"@preact/signals": "^2.11.3",
		"@preact/signals-core": "^1.14.4",
		"@sqlite.org/sqlite-wasm": "^3.51.2-build9",
		"@tanstack/react-virtual": "^3.14.13",
		"chart.js": "^4.5.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"fflate": "^0.8.3",
		"fzstd": "^0.1.1",
		"monkey-around": "^3.0.0",
		"motion": "12.35.0",
		"obsidian": "^1.13.1",
		"pako": "^2.2.0",
		"preact": "^10.29.8",
		"ts-fsrs": "^5.4.2",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	}
}
