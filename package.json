{
	"name": "obsidian-true-recall",
	"version": "1.0.0",
	"description": "Spaced repetition with FSRS algorithm for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "bun build.ts",
		"build": "tsc -noEmit -skipLibCheck && bun build.ts production",
		"version": "bun version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"format": "biome format --write src/",
		"biome": "biome check src/",
		"test": "bun vitest run",
		"test:watch": "bun vitest",
		"test:coverage": "bun vitest run --coverage",
		"render:excalidraw": "bunx --bun excalirender"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.4.2",
		"@eslint/js": "9.30.1",
		"@tailwindcss/cli": "^4.2.0",
		"@types/bun": "^1.3.9",
		"@types/node": "^20.0.0",
		"@types/sortablejs": "^1.15.9",
		"@types/sql.js": "^1.4.9",
		"@vitest/coverage-v8": "^1.6.1",
		"eslint-plugin-obsidianmd": "0.1.9",
		"excalirender": "github:JonRC/excalirender",
		"globals": "14.0.0",
		"tailwindcss": "^4.1.18",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^1.6.1"
	},
	"dependencies": {
		"@langchain/classic": "^1.0.10",
		"@langchain/core": "^1.1.15",
		"@langchain/openai": "^1.2.2",
		"@preact/signals": "^2.8.1",
		"@supabase/supabase-js": "^2.91.1",
		"chart.js": "^4.5.1",
		"class-variance-authority": "^0.7.1",
		"fzstd": "^0.1.1",
		"jszip": "^3.10.1",
		"obsidian": "latest",
		"preact": "^10.28.4",
		"sortablejs": "^1.15.6",
		"sql.js": "^1.13.0",
		"ts-fsrs": "^5.2.3",
		"zod": "^4.3.5",
		"zod-to-json-schema": "^3.25.1",
		"zustand": "^5.0.11"
	}
}
