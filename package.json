{
	"name": "obsidian-true-recall",
	"version": "1.1.0",
	"description": "Spaced repetition with FSRS algorithm for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
		"version": "bun version-bump.mjs && git add manifest.json versions.json",
		"format": "biome format --write src/",
		"biome": "biome check --write src/",
		"test": "bun vitest run",
		"test:watch": "bun vitest",
		"test:coverage": "bun vitest run --coverage",
		"render:excalidraw": "bunx --bun excalirender",
		"perf:benchmark": "bun scripts/perf-benchmark.ts"
	},
	"keywords": [],
	"license": "SEE LICENSE IN LICENSE",
	"devDependencies": {
		"@biomejs/biome": "2.4.2",
		"@tailwindcss/cli": "^4.2.0",
		"@types/bun": "^1.3.9",
		"@types/node": "^20.0.0",
		"@types/pako": "^2.0.4",
		"@types/sortablejs": "^1.15.9",
		"@vitest/coverage-v8": "^1.6.1",
		"esbuild": "^0.27.3",
		"excalirender": "github:JonRC/excalirender",
		"sql.js": "^1.14.1",
		"tailwindcss": "^4.1.18",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"vitest": "^1.6.1"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.7.5",
		"@preact/signals": "^2.8.1",
		"@sqlite.org/sqlite-wasm": "^3.51.2-build6",
		"chart.js": "^4.5.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"downshift": "^9.3.2",
		"fzstd": "^0.1.1",
		"jszip": "^3.10.1",
		"monkey-around": "^3.0.0",
		"motion": "^12.35.0",
		"obsidian": "latest",
		"pako": "^2.1.0",
		"preact": "^10.28.4",
		"sortablejs": "^1.15.6",
		"ts-fsrs": "^5.2.3",
		"zod": "^4.3.5",
		"zustand": "^5.0.11"
	}
}
