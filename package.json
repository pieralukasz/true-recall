{
	"name": "true-recall",
	"version": "1.9.0",
	"private": true,
	"description": "Spaced repetition with FSRS algorithm",
	"main": "main.js",
	"type": "module",
	"workspaces": [
		"packages/*",
		"packages/plugins"
	],
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
		"version": "bun version-bump.mjs && git add manifest.json versions.json",
		"format": "biome format --write packages/",
		"biome": "biome check --write packages/",
		"test": "bun vitest run",
		"test:watch": "bun vitest",
		"test:coverage": "bun vitest run --coverage",
		"render:excalidraw": "bunx --bun excalirender",
		"changelog": "bun scripts/generate-changelog.ts",
		"changelog:preview": "bun scripts/generate-changelog.ts --preview",
		"perf:benchmark": "bun scripts/perf-benchmark.ts",
		"cli:build": "cd cli && bun build --compile --minify index.ts --outfile true-recall",
		"knip": "bunx knip"
	},
	"keywords": [],
	"license": "LicenseRef-True-Recall-Source-Available-1.0",
	"devDependencies": {
		"@biomejs/biome": "2.4.2",
		"@tailwindcss/cli": "^4.2.0",
		"@types/bun": "^1.3.9",
		"@types/node": "^20.0.0",
		"@types/pako": "^2.0.4",
		"@vitest/coverage-v8": "^1.6.1",
		"esbuild": "^0.27.3",
		"excalirender": "github:JonRC/excalirender",
		"knip": "^6.3.1",
		"sql.js": "^1.14.1",
		"tailwindcss": "^4.1.18",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"vitest": "^1.6.1"
	},
	"dependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "^6.35.0",
		"@floating-ui/dom": "^1.7.5",
		"@preact/signals": "^2.8.1",
		"@preact/signals-core": "^1.8.0",
		"@sqlite.org/sqlite-wasm": "^3.51.2-build6",
		"@tanstack/react-virtual": "^3.13.23",
		"chart.js": "^4.5.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"fflate": "^0.8.3",
		"fzstd": "^0.1.1",
		"monkey-around": "^3.0.0",
		"motion": "12.35.0",
		"obsidian": "latest",
		"pako": "^2.1.0",
		"preact": "^10.28.4",
		"ts-fsrs": "^5.2.3",
		"zod": "^4.3.5",
		"zustand": "^5.0.11"
	}
}
